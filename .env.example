# Copy this file to .env and adjust if needed before running docker-compose.
# .env itself is gitignored — never commit real credentials.

# --- Warehouse Postgres (the grandvista database) ---
POSTGRES_DB=grandvista
POSTGRES_USER=grandvista
POSTGRES_PASSWORD=grandvista
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- MinIO (S3-compatible local object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Airflow ---
# Default web UI login created by airflow-init: admin / admin
